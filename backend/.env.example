# Server Configuration
PORT=3100
NODE_ENV=development
HOST=localhost

# AI Provider Configuration
# Set AI_PROVIDER explicitly when selecting a provider. mock is disabled in production.
# If unset, available provider credentials are selected by deterministic factory priority.
# AI_PROVIDER=openai # Options: gemini, groq, openai, mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
# Production browser origins, comma-separated exact origins (scheme + host, no paths).
# The pinned chrome-extension origin is for local development only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,chrome-extension://ifphhdmamiodijdfbplkfbkoclpclcmi

# Dynamic API discovery (server-registered integrations only; disabled by default)
DYNAMIC_API_DISCOVERY_ENABLED=false
API_DISCOVERY_ALLOWED_HOSTS=localhost
API_DISCOVERY_TIMEOUT_MS=5000
API_DISCOVERY_MAX_SPEC_BYTES=1048576

# Local HirePool integration (development only; never enable in production)
ENABLE_HIREPOOL_LOCAL_BRIDGE=false
HIREPOOL_LOCAL_API_BASE_URL=http://localhost:8000/
HIREPOOL_LOCAL_OPENAPI_URL=http://localhost:8000/api/openapi.json
HIREPOOL_LOCAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,chrome-extension://ifphhdmamiodijdfbplkfbkoclpclcmi

# Session Configuration
SESSION_TTL_MS=7200000
MAX_CONTEXT_MESSAGES=20

# Authentication & Authorization Configuration
# AUTH_MODE options: 'none' (development only), 'jwt', 'api-key', 'hybrid'
# Production endpoints require authentication; configure a supported mode and secret.
# Never expose JWT_SECRET or API_KEY to the browser.
AUTH_MODE=none
AUTH_REQUIRED=false
# Enable only the separately maintained HirePool action definitions.
ENABLE_HIREPOOL_INTEGRATION=false
# Secret key used to verify HS256 JWT tokens (required when AUTH_MODE=jwt or AUTH_REQUIRED=true)
JWT_SECRET=your_jwt_secret_here
# Optional JWT claims verification
# JWT_ISSUER=your_issuer_here
# JWT_AUDIENCE=your_audience_here
# Optional server API key for service-to-service authentication (required when AUTH_MODE=api-key)
# API_KEY=your_service_api_key_here

# Shared state for Vercel (Upstash Redis via the Vercel marketplace).
# Leave unset locally: everything stays in memory. When set, all three are required.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# 32 random bytes, base64 (generate with: openssl rand -base64 32). Encrypts every stored record.
# STATE_ENCRYPTION_KEY=

# Website bot / in-app bot origins (defaults include the local ports below outside production)
# Production: website visitors get guest access to the HirePool bot ONLY from origins listed in
# HIREPOOL_WEBSITE_ORIGINS, and only when AUTH_MODE=jwt with JWT_SECRET is set.
# HIREPOOL_WEBSITE_ORIGINS=http://localhost:3000,http://localhost:3001
# HIREPOOL_APP_ORIGINS=http://localhost:5173

# Links the bot shows. Local-only for now; set these only when production links are approved.
# HIREPOOL_APP_LOGIN_URL=http://localhost:5173/login
# HIREPOOL_PUBLIC_SITE_URL=http://localhost:3000

# Optional extras (defaults are fine for most setups)
# GROQ_API_KEY=            # only if AI_PROVIDER=groq
# GROQ_MODEL=
# HIREPOOL_SESSION_TTL_MS= # how long an assistant login stays valid
# HIREPOOL_OPENAPI_URL=    # alternative HirePool OpenAPI URL
# DYNAMIC_API_AUTO_DISCOVER=
# ENABLE_INTEGRATION_DEMO=
# DEBUG=
